# Copy to .env and fill in. `.env` is gitignored and must never be committed.
#
# Not every variable is needed for every deployment — see the groups below.

# ---------------------------------------------------------------------------
# 1. Supabase (required everywhere)
#
# BOTH of these are safe to expose in a browser. The anon key is a public
# identifier whose power is bounded entirely by the Row Level Security policies
# in supabase/migrations/. That is the bargain RLS makes: the key is public,
# and the database decides what it may do.
#
# Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Used only by CI to apply migrations, and by `pnpm db:push` locally.
# Use the POOLER host: db.<ref>.supabase.co is IPv6-only and refuses IPv4.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# 1b. The project signing key (required by every deployment)
#
# !!! THE PRIVATE KEY IS GENUINELY SECRET !!!
#
# Since the attributed-messages migration, the anon key has NO grants on
# public.messages — it cannot read or write it. Every request instead carries a
# short-lived ES256 token minted for the verified caller, and RLS compares its
# claims against the row being written. Forging an entry requires this key.
#
# Create one with an asymmetric algorithm (Supabase's current recommendation;
# the legacy shared HS256 secret still works but is being removed late 2026):
#
#   1. Generate an ES256/P-256 keypair locally and KEEP the private half —
#      Supabase never returns private key material once imported.
#   2. Import it via the Management API as a `standby` key. Verified: standby
#      keys ARE published in the JWKS and DO verify, so your key never has to
#      become the active key Supabase Auth signs its own tokens with.
#   3. The `kid` is the key id the API returns.
#
# SUPABASE_JWT_PRIVATE_KEY is the private JWK as one line of JSON — a JWK
# rather than PEM specifically because it survives being an environment
# variable on every platform without newline mangling.
SUPABASE_JWT_KID=
SUPABASE_JWT_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# 2. ATProto OAuth (the Vercel deployment — all of it REQUIRED)
# ---------------------------------------------------------------------------

# !!! GENUINELY SECRET !!!
#
# service_role BYPASSES Row Level Security completely. Anyone holding it can
# read and write every table regardless of policy.
#
# An earlier version of this file said the project would never need it. That
# stopped being true when ATProto OAuth landed: refresh tokens and DPoP private
# keys cannot live under the anon key, so they sit in tables that are REVOKEd
# from anon, and only service_role can reach them.
#
# It belongs ONLY in the Vercel Function's environment. Never in a Worker,
# never in a browser, never in git. Set it with:
#   pnpm --filter @playstack/web exec vercel env add SUPABASE_SERVICE_ROLE_KEY production
SUPABASE_SERVICE_ROLE_KEY=

# Signs this app's own session cookie (which carries only did + handle, never
# an ATProto token). Generate with: openssl rand -hex 32
SESSION_SECRET=

# The STABLE public origin. OAuth requires client_id, the metadata URL and the
# redirect URI to agree exactly, so this must not be a per-deployment URL like
# playstack-<hash>.vercel.app — those change on every push and break login.
PUBLIC_ORIGIN=https://playstack-nine.vercel.app

# Must be "on". REQUIRED — the Function throws at cold start without it.
#
# This used to be opt-in, where anything other than "on" meant the deployment
# quietly served an ungated guestbook. That was the worst possible default:
# unsetting one variable silently removed all authentication, and nothing in
# the response said so. It now fails closed, like the Access Worker.
ATPROTO_GATE=on

# ---------------------------------------------------------------------------
# 3. Cloudflare Access (apps/worker-access only)
#
# NOT secret, and not set here — they live as plain `vars` in
# apps/worker-access/wrangler.jsonc so they are reviewable in git.
# The AUD is even handed out in the unauthenticated login redirect. Security
# comes from verifying Cloudflare's JWT signature, not from hiding these.
#
#   ACCESS_TEAM_DOMAIN=mfd-is
#   ACCESS_AUD=<application audience tag>
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 4. Optional: used by `uv run playstack-ops status`
# ---------------------------------------------------------------------------
# VERCEL_URL=https://playstack-nine.vercel.app
# ACCESS_URL=https://playstack.haha.computer

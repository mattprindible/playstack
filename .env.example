# Copy to .env and fill in. `.env` is gitignored and must never be committed.
#
# Both values below are SAFE to expose in a browser. The anon key is a public
# identifier whose power is bounded entirely by the Row Level Security policies
# in supabase/migrations/. That is the deal RLS makes: the key is public, the
# database decides what it can do.
#
# Find these under: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# NEVER put the service_role key in this file, in a Worker, or in any frontend.
# service_role BYPASSES Row Level Security completely. It belongs only in a
# trusted server context, and this project does not need it at all.

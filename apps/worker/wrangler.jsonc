{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playstack",
  "main": "src/index.ts",

  // Pin the runtime's behaviour to a date. Cloudflare ships fixes that would
  // otherwise be breaking changes behind this flag, so an old Worker keeps
  // running exactly as it did the day you deployed it. Bump it deliberately.
  "compatibility_date": "2026-08-01",

  // Serve the SAME static directory the Vercel deployment serves.
  // Requests are matched against assets first; anything with no matching file
  // (i.e. /api/*) falls through to the Worker in src/index.ts.
  "assets": {
    "directory": "../web/public"
  },

  "observability": {
    "enabled": true
  }

  // No secrets here on purpose. SUPABASE_URL and SUPABASE_ANON_KEY are set with
  //   pnpm --filter @playstack/worker exec wrangler secret put SUPABASE_URL
  // and locally via apps/worker/.dev.vars (gitignored).
  //
  // They would be safe to commit as plaintext `vars` — the anon key is public
  // by design — but treating all configuration as secret is the habit that
  // keeps you from committing the one that isn't.
}
